# ── Google Gemini & Groq ───────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── GitHub ─────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=          # e.g. username/my-demo-site

# ── Target Website ─────────────────────────────────────────
WEBSITE_URL=          # e.g. https://my-demo.vercel.app

# ── PageSpeed Insights ─────────────────────────────────────
PSI_API_KEY=

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=

# ── LangSmith Observability ────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=awpis-demo

# ── Vercel Deploy ──────────────────────────────────────────
VERCEL_TOKEN=

# ── Run Mode ───────────────────────────────────────────────
RUN_MODE=SUPERVISED   # SUPERVISED or AUTOMATED

# ── Operational tunables ───────────────────────────────────
DB_NAME=awpis
MAX_RETRIES=3
PSI_TIMEOUT=60
SANDBOX_TIMEOUT=300
LOG_LEVEL=INFO
DEMO_MODE=true
